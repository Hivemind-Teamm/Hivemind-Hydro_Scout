rules_version = '2';
// unitLocations/{uid_deviceId}: stationId, deviceId, updatedBy, lat, lng, accuracy, updatedAt.
// Station profiles live at stations/{stationId}/accounts/{uid}; their lookup
// index at stationAccountIndex/{uid} contains only stationId.
//
// Station AOR (Area of Responsibility):
// stations/{stationId}.aorBarangays lists the barangays a station covers.
// Hydrant writes by non-admins are limited to hydrants whose barangay is in
// the AOR of the account's own station (station accounts, or approved
// members). hydrants/{id}.barangay is derived from GPS by POST /api/hydrants
// and is immutable to non-admins, so it can be trusted here.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function hasValidStationAccountIndex(uid) {
      let indexPath = /databases/$(database)/documents/stationAccountIndex/$(uid);
      return exists(indexPath)
        && get(indexPath).data.keys().hasOnly(['stationId'])
        && get(indexPath).data.stationId is string
        && get(indexPath).data.stationId.size() > 0
        && get(indexPath).data.stationId.size() <= 128
        && get(indexPath).data.stationId.matches('^[A-Za-z0-9_-]+$')
        && exists(/databases/$(database)/documents/stations/$(get(indexPath).data.stationId)/accounts/$(uid))
        && get(/databases/$(database)/documents/stations/$(get(indexPath).data.stationId)/accounts/$(uid)).data.uid == uid
        && get(/databases/$(database)/documents/stations/$(get(indexPath).data.stationId)/accounts/$(uid)).data.accountType == 'station'
        && get(/databases/$(database)/documents/stations/$(get(indexPath).data.stationId)/accounts/$(uid)).data.stationId == get(indexPath).data.stationId;
    }

    function currentUserData() {
      return isSignedIn()
        ? (exists(/databases/$(database)/documents/stationAccountIndex/$(request.auth.uid))
          ? (hasValidStationAccountIndex(request.auth.uid)
            ? get(/databases/$(database)/documents/stations/$(get(/databases/$(database)/documents/stationAccountIndex/$(request.auth.uid)).data.stationId)/accounts/$(request.auth.uid)).data
            : {})
          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        : {};
    }

    function userRole() {
      return isSignedIn() ? currentUserData().get('role', null) : null;
    }

    function isStationAccount() { return currentUserData().get('accountType', null) == 'station'; }
    function isGeneral()    { return !isStationAccount() && userRole() == 'general'; }
    function isAuthorized() { return isStationAccount() || userRole() == 'authorized'; }
    function isHead()       { return isStationAccount() || userRole() == 'head'; }
    function isAdmin()      { return !isStationAccount() && userRole() == 'admin'; }

    function isAnyRole() {
      return isGeneral() || isAuthorized() || isHead() || isAdmin();
    }

    function isHeadForStation(stationId) {
      return isSignedIn() && (isStationAccount() || userRole() == 'head')
        && currentUserData().stationId == stationId;
    }

    // Membership approval is an operational responsibility of a personal
    // station head. Station logins and global technical administrators must
    // not review or approve personnel membership requests.
    function isPersonalHeadForStation(stationId) {
      return isSignedIn()
        && !isStationAccount()
        && userRole() == 'head'
        && currentUserData().stationId == stationId;
    }

    function canManageStation(stationId) {
      return isSignedIn() && (isAdmin() || isHeadForStation(stationId)
        || (currentUserData().get('stationAccessIds', []) is list
          && stationId in currentUserData().get('stationAccessIds', [])));
    }

    function isApprovedStationMember(stationId) {
      return isSignedIn()
        && currentUserData().get('accountType', null) == 'person'
        && currentUserData().get('stationMembershipStatus', null) == 'approved'
        && currentUserData().stationId == stationId;
    }

    function validResponsePointerUpdate(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return (after.activeResponseId is string
          && (!('activeResponseId' in before) || before.activeResponseId == null)
          && getAfter(/databases/$(database)/documents/stationResponses/$(after.activeResponseId)).data.uid == uid
          && getAfter(/databases/$(database)/documents/stationResponses/$(after.activeResponseId)).data.responseId == after.activeResponseId
          && getAfter(/databases/$(database)/documents/stationResponses/$(after.activeResponseId)).data.status == 'active')
        || (after.activeResponseId == null
          && before.activeResponseId is string
          && getAfter(/databases/$(database)/documents/stationResponses/$(before.activeResponseId)).data.uid == uid
          && getAfter(/databases/$(database)/documents/stationResponses/$(before.activeResponseId)).data.status == 'ended');
    }

    // Map activity is immutable, belongs to the actor's station, and discloses
    // only pin coordinates. Hydrant pins must accompany a new hydrant write.
    function isValidMapNotification(stationId) {
      let data = request.resource.data;
      return data.keys().hasAll(['type', 'uid', 'displayName', 'message', 'createdAt', 'lat', 'lng'])
        && data.keys().hasOnly(['type', 'uid', 'displayName', 'message', 'createdAt', 'lat', 'lng', 'hydrantId', 'firePinId'])
        && (isAuthorized() || isHead() || isAdmin())
        && currentUserData().stationId == stationId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
        && data.displayName == currentUserData().get('displayName', 'Responder')
        && data.createdAt == request.time
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && ((data.type == 'fire-pinned'
            && !('hydrantId' in data)
            && (!('firePinId' in data) || (data.firePinId is string && data.firePinId.matches('^[a-zA-Z0-9]{20}$')
              && getAfter(/databases/$(database)/documents/firePins/$(data.firePinId)).data.createdAt == request.time
              && getAfter(/databases/$(database)/documents/firePins/$(data.firePinId)).data.lat == data.lat
              && getAfter(/databases/$(database)/documents/firePins/$(data.firePinId)).data.lng == data.lng
              && getAfter(/databases/$(database)/documents/firePinOwners/$(data.firePinId)).data.uid == request.auth.uid))
            && data.message == data.displayName + ' pinned a fire incident.')
          || (data.type in ['hydrant-pinned', 'hydrant-updated']
            && !('firePinId' in data)
            && data.hydrantId is string && data.hydrantId.matches('^HYD-[0-9]{3}$')
            && ((data.type == 'hydrant-pinned'
                && !exists(/databases/$(database)/documents/hydrants/$(data.hydrantId))
                && getAfter(/databases/$(database)/documents/hydrants/$(data.hydrantId)).data.createdAt == request.time)
              || (data.type == 'hydrant-updated'
                && exists(/databases/$(database)/documents/hydrants/$(data.hydrantId))
                && get(/databases/$(database)/documents/hydrants/$(data.hydrantId)).data.get('updatedAt', null) != request.time
                && getAfter(/databases/$(database)/documents/hydrants/$(data.hydrantId)).data.updatedAt == request.time))
            && getAfter(/databases/$(database)/documents/hydrants/$(data.hydrantId)).data.location.latitude() == data.lat
            && getAfter(/databases/$(database)/documents/hydrants/$(data.hydrantId)).data.location.longitude() == data.lng
            && data.message == data.displayName + (data.type == 'hydrant-pinned' ? ' pinned hydrant ' : ' updated hydrant ') + data.hydrantId + '.'));
    }

    function isValidStationNotification(stationId, notificationId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'type', 'uid', 'displayName', 'responseId', 'message', 'createdAt',
          'adminEmail', 'targetUid', 'targetName'
        ])
        && data.type is string
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 120
        && data.message is string && data.message.size() <= 600
        && data.createdAt == request.time
        && ((data.type == 'personal-station-assigned'
              && isAdmin()
              && data.uid == request.auth.uid
              && data.adminEmail is string
              && data.adminEmail == request.auth.token.email
              && data.adminEmail.size() <= 254
              && data.targetUid is string && data.targetUid.size() > 0 && data.targetUid.size() <= 128
              && data.targetName is string && data.targetName.size() > 0 && data.targetName.size() <= 120
              && notificationId.matches('^account-assignment-[a-f0-9-]{36}$')
              && data.message == 'Admin account: ' + data.adminEmail + ' changed "' + data.targetName + '" station to ' + stationId + '.'
              // Self-signup profiles have no stationId (and legacy ones may lack
              // accountType); a missing field must not error the whole rule.
              && get(/databases/$(database)/documents/users/$(data.targetUid)).data.get('accountType', 'person') == 'person'
              && get(/databases/$(database)/documents/users/$(data.targetUid)).data.get('stationId', null) != stationId
              && getAfter(/databases/$(database)/documents/users/$(data.targetUid)).data.accountType == 'person'
              && getAfter(/databases/$(database)/documents/users/$(data.targetUid)).data.stationId == stationId
              && getAfter(/databases/$(database)/documents/users/$(data.targetUid)).data.displayName == data.targetName)
          || (data.type in ['response-started', 'response-ended']
              && data.uid == request.auth.uid
              && data.displayName == currentUserData().displayName
              && data.responseId is string
              && notificationId == data.responseId + (data.type == 'response-started' ? '_start' : '_end')
              && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.stationId == stationId
              && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.uid == request.auth.uid
              && ((data.type == 'response-started'
                    && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.startedAt == request.time
                    && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.status == 'active')
                || (data.type == 'response-ended'
                    && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.endedAt == request.time
                    && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.status == 'ended'
                    && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.endedByUid == request.auth.uid)))
          || (data.type == 'station-response-closed'
              && canManageStation(stationId)
              && notificationId == data.responseId + '_closed'
              && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.stationId == stationId
              && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.status == 'ended'
              && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.endedByUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/stationResponses/$(data.responseId)).data.endReason == 'station-head')
          || (data.type == 'station-accessed'
              && data.uid == request.auth.uid
              && data.displayName == currentUserData().displayName
              && canManageStation(stationId))
          || (data.type in ['membership-approved', 'membership-rejected']
              && isPersonalHeadForStation(stationId)
              && notificationId == 'join-review-' + data.uid + (data.type == 'membership-approved' ? '-approved' : '-rejected')
              && getAfter(/databases/$(database)/documents/stationJoinRequests/$(data.uid)).data.stationId == stationId
              && getAfter(/databases/$(database)/documents/stationJoinRequests/$(data.uid)).data.status == (data.type == 'membership-approved' ? 'approved' : 'rejected')
              && getAfter(/databases/$(database)/documents/users/$(data.uid)).data.stationMembershipStatus == (data.type == 'membership-approved' ? 'approved' : 'rejected')));
    }

    function onlyChangedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Hydrant write tier for the caller on a hydrant in `barangay`:
    //   'admin'      anywhere;
    //   'head'       station accounts and heads, inside their station's AOR;
    //   'authorized' authorized members, inside their station's AOR;
    //   'none'       otherwise.
    // The AOR station is the account's own station (station accounts) or its
    // station once membership is approved. Callers pass the EXISTING hydrant's
    // barangay, never request data, so a client cannot move a hydrant into its
    // own AOR. The profile and station are read once: batched writes (hydrant
    // edit + activity notice) share Firestore's 1,000-expression budget.
    function hydrantAccess(barangay) {
      let profile = currentUserData();
      let isStation = profile.get('accountType', null) == 'station';
      let role = profile.get('role', null);
      let stationId = profile.get('stationId', null);
      let hasStation = stationId is string
        && (isStation || profile.get('stationMembershipStatus', null) == 'approved');
      let station = hasStation ? get(/databases/$(database)/documents/stations/$(stationId)).data : {};
      let inAor = hasStation && barangay is string
        && station.get('active', false) == true
        && barangay in station.get('aorBarangays', []);
      return !isStation && role == 'admin' ? 'admin'
        : inAor && (isStation || role == 'head') ? 'head'
        : inAor && role == 'authorized' ? 'authorized'
        : 'none';
    }

    function canUpdateHydrant() {
      let access = hydrantAccess(resource.data.get('barangay', null));
      return access == 'admin'
        || (access == 'head' && onlyChangedFields([
              'operationalStatus',
              'pressureStatus',
              'waterCleanliness',
              'hazards',
              'photos',
              'notes',
              'fieldNotes',
              'register',
              'lastMaintenanceDate',
              'nextMaintenanceDate',
              'updatedBy',
              'updatedAt'
            ]))
        || (access == 'authorized'
          && onlyChangedFields(['operationalStatus', 'pressureStatus', 'register', 'updatedBy', 'updatedAt'])
          && appendsAtMostOneRegisterEntry());
    }

    // Status edits log one register entry; earlier entries cannot be rewritten.
    function appendsAtMostOneRegisterEntry() {
      let before = resource.data.get('register', []);
      let after = request.resource.data.get('register', []);
      return after == before
        || (after is list && after.size() == before.size() + 1 && after.hasAll(before));
    }

    function hydrantBarangay(hydrantId) {
      return get(/databases/$(database)/documents/hydrants/$(hydrantId)).data.get('barangay', null);
    }

    function isValidStationAccount(stationId, uid, allowLegacyRole) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'accountType', 'station',
          'stationId', 'aorBarangays', 'createdAt', 'lastLoginAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'accountType', 'station',
          'stationId', 'aorBarangays', 'stationAccessIds', 'createdAt',
          'lastLoginAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.email is string && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && (!('role' in data)
          || (allowLegacyRole && data.role in ['authorized', 'head', 'admin']))
        && data.accountType == 'station'
        && data.station is string && data.station.size() > 0 && data.station.size() <= 120
        && data.stationId == stationId
        && data.aorBarangays is list && data.aorBarangays.size() <= 100
        && (!('stationAccessIds' in data)
          || (data.stationAccessIds is list && data.stationAccessIds.size() <= 10))
        && data.createdAt is timestamp
        && (data.lastLoginAt == null || data.lastLoginAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // ---------- users ----------

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin()
        || canManageStation(resource.data.stationId));

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && onlyChangedFields(['lastLoginAt', 'activeResponseId'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeResponseId'])
              || validResponsePointerUpdate(uid)))
        || (isSignedIn() && resource.data.requestedStationId is string
            && canManageStation(resource.data.requestedStationId)
            && onlyChangedFields(['stationId', 'station', 'stationMembershipStatus', 'requestedStationId'])
            && request.resource.data.stationMembershipStatus in ['approved', 'rejected']
            && ((request.resource.data.stationMembershipStatus == 'approved'
                && request.resource.data.stationId == resource.data.requestedStationId
                && request.resource.data.station is string && request.resource.data.station.size() <= 120)
              || (request.resource.data.stationMembershipStatus == 'rejected'
                && request.resource.data.stationId == null))
            && request.resource.data.requestedStationId == null)
        || (isSignedIn() && resource.data.stationId is string
            && (isHeadForStation(resource.data.stationId) || isAdmin())
            && onlyChangedFields(['stationAccessIds'])
            && request.resource.data.stationAccessIds is list
            && request.resource.data.stationAccessIds.size() <= 10
            && request.resource.data.stationAccessIds.hasOnly([resource.data.stationId]))
        || ((isHeadForStation(resource.data.stationId) || isAdmin())
            && resource.data.activeResponseId is string
            && onlyChangedFields(['activeResponseId'])
            && request.resource.data.activeResponseId == null
            && getAfter(/databases/$(database)/documents/stationResponses/$(resource.data.activeResponseId)).data.uid == uid
            && getAfter(/databases/$(database)/documents/stationResponses/$(resource.data.activeResponseId)).data.status == 'ended'
            && getAfter(/databases/$(database)/documents/stationResponses/$(resource.data.activeResponseId)).data.endReason == 'station-head');

      // New users can create their own document (signup flow).
      // Only admins can create documents for other users or delete any.
      // Self-signup cannot grant a role or station assignment used by location rules.
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'accountType', 'stationMembershipStatus',
          'requestedStationId', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.role == 'general'
        && request.resource.data.accountType == 'person'
        && request.resource.data.stationMembershipStatus in ['none', 'pending']
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastLoginAt is timestamp
        && ((!('requestedStationId' in request.resource.data)
              && request.resource.data.stationMembershipStatus == 'none')
          || (request.resource.data.requestedStationId is string
              && request.resource.data.requestedStationId.size() <= 128
              && request.resource.data.requestedStationId.matches('^[A-Za-z0-9_-]+$')
              && request.resource.data.stationMembershipStatus == 'pending'
              && get(/databases/$(database)/documents/stations/$(request.resource.data.requestedStationId)).data.active == true)));

      allow delete: if isAdmin();
    }

    match /stationJoinRequests/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isPersonalHeadForStation(resource.data.stationId));
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'stationId', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.stationId is string && request.resource.data.stationId.size() <= 128
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.requestedStationId == request.resource.data.stationId
        && get(/databases/$(database)/documents/stations/$(request.resource.data.stationId)).data.active == true;
      allow update: if isPersonalHeadForStation(resource.data.stationId)
        && resource.data.status == 'pending'
        && onlyChangedFields(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.stationMembershipStatus == request.resource.data.status
        && getAfter(/databases/$(database)/documents/stations/$(resource.data.stationId)/notifications/$(('join-review-' + uid + (request.resource.data.status == 'approved' ? '-approved' : '-rejected')))).data.uid == uid;
      // Join requests are retained as an approval record. Administrators do
      // not manage personnel approvals, and no role may remove this record.
      allow delete: if false;
    }

    // Active station directory fields are public to signed-out signup pages.
    match /stations/{stationId} {
      allow read: if true;
      function validStationAor() {
        let data = request.resource.data;
        return (!('aorBarangays' in data)
            || (data.aorBarangays is list && data.aorBarangays.size() <= 60))
          && (!('aorUpdatedAt' in data) || data.aorUpdatedAt is timestamp);
      }
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdAt', 'aorBarangays', 'aorUpdatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && validStationAor();
      // Diff-based so stations seeded with extra legacy fields stay editable.
      allow update: if isAdmin()
        && onlyChangedFields(['name', 'active', 'aorBarangays', 'aorUpdatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.active is bool
        && validStationAor();
      allow delete: if isAdmin();

      match /accounts/{uid} {
        allow read: if isSignedIn() && (
          request.auth.uid == uid
          || isAdmin()
          || canManageStation(stationId)
        );
        allow create: if isAdmin()
          && isValidStationAccount(stationId, uid, false)
          && getAfter(/databases/$(database)/documents/stations/$(stationId)).data.active == true
          && getAfter(/databases/$(database)/documents/stationAccountIndex/$(uid)).data.stationId == stationId;
        allow update: if (isAdmin()
            && isValidStationAccount(stationId, uid, false)
            && getAfter(/databases/$(database)/documents/stationAccountIndex/$(uid)).data.stationId == stationId)
          || (isSignedIn() && request.auth.uid == uid
            && onlyChangedFields(['lastLoginAt'])
            && request.resource.data.get('role', null) == resource.data.get('role', null)
            && isValidStationAccount(stationId, uid, true)
            && hasValidStationAccountIndex(uid));
        allow delete: if isAdmin()
          && (!existsAfter(/databases/$(database)/documents/stationAccountIndex/$(uid))
            || getAfter(/databases/$(database)/documents/stationAccountIndex/$(uid)).data.stationId != stationId);
      }

      match /notifications/{notificationId} {
        // Other roles receive a server-filtered projection through /api/notifications.
        allow read: if isAdmin() || isHeadForStation(stationId);
        allow create: if isSignedIn() && (isValidMapNotification(stationId) || isValidStationNotification(stationId, notificationId));
        allow update, delete: if false;
      }

      // Per-viewer read receipts; reading a panel alone never writes a receipt.
      match /notificationReads/{viewerUid}/items/{receiptId} {
        function ownsReadState() {
          return isSignedIn() && request.auth.uid == viewerUid && (isAdmin() || isHeadForStation(stationId));
        }
        function validReadReceipt() {
          let data = request.resource.data;
          return data.keys().hasAll(['kind', 'notificationId', 'eventCreatedAt', 'readAt'])
            && data.keys().hasOnly(['kind', 'notificationId', 'eventCreatedAt', 'readAt'])
            && data.kind in ['activity', 'member']
            && data.notificationId is string && data.notificationId.size() > 0 && data.notificationId.size() <= 256
            && !data.notificationId.matches('.*[/].*')
            && receiptId == data.kind + '_' + data.notificationId
            && data.eventCreatedAt is timestamp
            && data.readAt is timestamp && data.readAt == request.time
            && ((data.kind == 'activity'
                  && get(/databases/$(database)/documents/stations/$(stationId)/notifications/$(data.notificationId)).data.createdAt == data.eventCreatedAt)
              || (data.kind == 'member'
                  && isPersonalHeadForStation(stationId)
                  && get(/databases/$(database)/documents/stationJoinRequests/$(data.notificationId)).data.stationId == stationId
                  && get(/databases/$(database)/documents/stationJoinRequests/$(data.notificationId)).data.createdAt == data.eventCreatedAt));
        }
        allow read: if ownsReadState();
        allow create, update: if ownsReadState() && validReadReceipt();
        allow delete: if false;
      }

      match /accessLogs/{logId} {
        allow read: if isHeadForStation(stationId) || isAdmin();
        allow create: if canManageStation(stationId)
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName == currentUserData().displayName
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /stationAccountIndex/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['stationId'])
        && request.resource.data.stationId is string
        && request.resource.data.stationId.size() > 0
        && request.resource.data.stationId.size() <= 128
        && request.resource.data.stationId.matches('^[A-Za-z0-9_-]+$')
        && getAfter(/databases/$(database)/documents/stations/$(request.resource.data.stationId)/accounts/$(uid)).data.uid == uid
        && getAfter(/databases/$(database)/documents/stations/$(request.resource.data.stationId)/accounts/$(uid)).data.accountType == 'station'
        && getAfter(/databases/$(database)/documents/stations/$(request.resource.data.stationId)/accounts/$(uid)).data.stationId == request.resource.data.stationId;
      allow delete: if isAdmin();
    }

    match /{path=**}/accounts/{uid} {
      allow read: if isAdmin();
    }

    // ---------- station response records and public map locations ----------

    match /stationResponses/{responseId} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || canManageStation(resource.data.stationId));
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'responseId', 'uid', 'displayName', 'stationId', 'stationName', 'status', 'startedAt',
          'endedAt', 'lastLocationAt', 'firePinId', 'incidentLat', 'incidentLng'
        ])
        && request.resource.data.responseId == responseId
        && responseId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.firePinId is string
        && request.resource.data.firePinId.matches('^[a-zA-Z0-9]{20}$')
        && getAfter(/databases/$(database)/documents/firePins/$(request.resource.data.firePinId)).data.status == 'active'
        && request.resource.data.incidentLat == getAfter(/databases/$(database)/documents/firePins/$(request.resource.data.firePinId)).data.lat
        && request.resource.data.incidentLng == getAfter(/databases/$(database)/documents/firePins/$(request.resource.data.firePinId)).data.lng
        && request.resource.data.displayName == currentUserData().displayName
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120
        && request.resource.data.stationId is string
        && isApprovedStationMember(request.resource.data.stationId)
        && request.resource.data.stationName == get(/databases/$(database)/documents/stations/$(request.resource.data.stationId)).data.name
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null
        && request.resource.data.lastLocationAt == request.time
        && currentUserData().get('activeResponseId', null) == null
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeResponseId == responseId
        && (getAfter(/databases/$(database)/documents/stations/$(request.resource.data.stationId)/unitLocations/$(responseId)).data.responseId == responseId
          || getAfter(/databases/$(database)/documents/responseLocations/$(responseId)).data.responseId == responseId)
        && getAfter(/databases/$(database)/documents/stations/$(request.resource.data.stationId)/notifications/$(responseId + '_start')).data.responseId == responseId;
      allow update: if (isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'active'
        && isApprovedStationMember(resource.data.stationId)
        && onlyChangedFields(['lastLocationAt'])
        && request.resource.data.lastLocationAt == request.time)
        || (isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.status == 'ended'
        && onlyChangedFields(['status', 'endedAt', 'endedByUid', 'endedByName', 'endReason'])
        && request.resource.data.endedAt == request.time
        && request.resource.data.endedByUid == request.auth.uid
        && request.resource.data.endedByName == currentUserData().displayName
        && request.resource.data.endReason == 'member'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeResponseId == null
        && !existsAfter(/databases/$(database)/documents/stations/$(resource.data.stationId)/unitLocations/$(responseId))
        && !existsAfter(/databases/$(database)/documents/responseLocations/$(responseId))
        && getAfter(/databases/$(database)/documents/stations/$(resource.data.stationId)/notifications/$(responseId + '_end')).data.responseId == responseId)
        || ((isHeadForStation(resource.data.stationId) || isAdmin())
          && resource.data.status == 'active'
          && onlyChangedFields(['status', 'endedAt', 'endedByUid', 'endedByName', 'endReason'])
          && request.resource.data.status == 'ended'
          && request.resource.data.endedAt == request.time
          && request.resource.data.endedByUid == request.auth.uid
          && request.resource.data.endedByName == currentUserData().displayName
          && request.resource.data.endReason == 'station-head'
          && getAfter(/databases/$(database)/documents/users/$(resource.data.uid)).data.activeResponseId == null
          && !existsAfter(/databases/$(database)/documents/stations/$(resource.data.stationId)/unitLocations/$(responseId))
          && !existsAfter(/databases/$(database)/documents/responseLocations/$(responseId))
          && getAfter(/databases/$(database)/documents/stations/$(resource.data.stationId)/notifications/$(responseId + '_closed')).data.responseId == responseId);
      allow delete: if false;
    }

    function isLegacyAssignedStation(stationId) {
      return isSignedIn() && (isAuthorized() || isHead() || isAdmin())
        && currentUserData().get('accountType', null) == 'station'
        && currentUserData().stationId == stationId;
    }

    function isLegacyStationAccount() {
      return isSignedIn() && (isAuthorized() || isHead())
        && currentUserData().get('accountType', null) == 'station'
        && currentUserData().stationId is string
        && currentUserData().stationId.size() > 0
        && currentUserData().stationId.size() <= 128
        && currentUserData().stationId.matches('^[A-Za-z0-9_-]+$');
    }

    function isValidLegacyUnitLocation(reportId) {
      let data = request.resource.data;
      return data.keys().hasAll(['stationId', 'deviceId', 'updatedBy', 'lat', 'lng', 'accuracy', 'updatedAt'])
        && data.keys().hasOnly(['stationId', 'deviceId', 'updatedBy', 'lat', 'lng', 'accuracy', 'updatedAt'])
        && data.stationId is string && data.stationId.size() <= 128 && data.stationId.matches('^[A-Za-z0-9_-]+$')
        && data.deviceId is string && data.deviceId.size() == 36 && data.deviceId.matches('^[a-f0-9-]{36}$')
        && reportId == request.auth.uid + '_' + data.deviceId
        && data.updatedBy is string && data.updatedBy == request.auth.uid
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 40075000
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidUnitLocation(responseId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'responseId',
          'stationId',
          'stationName',
          'lat',
          'lng',
          'accuracy',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'responseId',
          'stationId',
          'stationName',
          'lat',
          'lng',
          'accuracy',
          'updatedAt'
        ])
        && data.responseId is string && data.responseId == responseId
        && data.stationId is string && data.stationId.size() <= 128
        && data.stationId.matches('^[A-Za-z0-9_-]+$')
        && data.stationName is string && data.stationName.size() > 0 && data.stationName.size() <= 120
        && data.stationName == getAfter(/databases/$(database)/documents/stationResponses/$(responseId)).data.stationName
        && getAfter(/databases/$(database)/documents/stationResponses/$(responseId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/stationResponses/$(responseId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/stationResponses/$(responseId)).data.stationId == data.stationId
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 40075000
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidStationUnitLocation(stationId, responseId) {
      let data = request.resource.data;
      let response = getAfter(/databases/$(database)/documents/stationResponses/$(responseId)).data;
      return data.keys().hasAll([
          'responseId',
          'stationId',
          'stationName',
          'public',
          'lat',
          'lng',
          'accuracy',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'responseId',
          'stationId',
          'stationName',
          'public',
          'lat',
          'lng',
          'accuracy',
          'updatedAt'
        ])
        && data.responseId is string && data.responseId == responseId
        && data.stationId is string && data.stationId == stationId
        && data.stationId.size() <= 128 && data.stationId.matches('^[A-Za-z0-9_-]+$')
        && data.stationName is string && data.stationName.size() > 0 && data.stationName.size() <= 120
        && data.stationName == response.stationName
        && data.public == true
        && response.uid == request.auth.uid
        && response.status == 'active'
        && response.stationId == stationId
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 40075000
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    match /responseLocations/{responseId} {
      allow read: if isSignedIn();
      allow create, update: if isApprovedStationMember(request.resource.data.stationId)
        && isValidUnitLocation(responseId);
      allow delete: if isSignedIn() && (
        isAdmin()
        || (get(/databases/$(database)/documents/stationResponses/$(responseId)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/stationResponses/$(responseId)).data.status == 'active')
        || (canManageStation(resource.data.stationId)
          && getAfter(/databases/$(database)/documents/stationResponses/$(responseId)).data.status == 'ended'));
    }

    // Legacy station-account locations retain their original private audience.
    // New response locations are kept in responseLocations, which omits the
    // responder UID from map-readable documents.
    match /unitLocations/{reportId} {
      allow read: if isAdmin() || isLegacyStationAccount();
      allow create, update: if isLegacyAssignedStation(request.resource.data.stationId)
        && isValidLegacyUnitLocation(reportId);
      allow delete: if isAdmin();
    }

    match /stations/{stationId}/unitLocations/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.get('public', false) == true
        || resource.data.get('updatedBy', null) == request.auth.uid
        || isLegacyAssignedStation(stationId)
        || canManageStation(stationId)
      );
      allow create, update: if (
        isApprovedStationMember(stationId)
        && isValidStationUnitLocation(stationId, reportId)
      ) || (
        isLegacyAssignedStation(stationId)
        && isValidLegacyUnitLocation(reportId)
        && request.resource.data.stationId == stationId
      );
      allow delete: if isSignedIn() && (
        isAdmin()
        || (get(/databases/$(database)/documents/stationResponses/$(reportId)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/stationResponses/$(reportId)).data.stationId == stationId
          && get(/databases/$(database)/documents/stationResponses/$(reportId)).data.status == 'active')
        || (canManageStation(stationId)
          && getAfter(/databases/$(database)/documents/stationResponses/$(reportId)).data.status == 'ended')
      );
    }

    // A collection-group query is used for the public, identity-free map pins.
    // Private station-account reports remain visible only to their owner/managers.
    match /{path=**}/unitLocations/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.get('public', false) == true
        || resource.data.get('updatedBy', null) == request.auth.uid
        || canManageStation(resource.data.stationId)
      );
    }

    // ---------- incident-linked GPS positions ----------
    // Separate from legacy unitLocations and station-response locations.
    // Incidents are provisioned through trusted server code only.
    function ownsIncidentLocation(locationId) {
      return isSignedIn()
        && locationId.matches('^' + request.auth.uid + '_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function incidentIsActiveAndAssignedNearby(incidentId, position) {
      let incidentPath = /databases/$(database)/documents/incidents/$(incidentId);
      return exists(incidentPath)
        && get(incidentPath).data.get('status', null) == 'active'
        && get(incidentPath).data.get('location', null) is latlng
        && position.distance(get(incidentPath).data.location) <= 500
        && get(incidentPath).data.get('assignedStationIds', []) is list
        && currentUserData().stationId in get(incidentPath).data.assignedStationIds;
    }

    function validIncidentUnitLocation(locationId) {
      let data = request.resource.data;
      return isSignedIn()
        && hasValidStationAccountIndex(request.auth.uid)
        && isStationAccount()
        && ownsIncidentLocation(locationId)
        && data.keys().hasAll([
          'stationId', 'updatedBy', 'incidentId', 'location', 'accuracy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'stationId', 'updatedBy', 'incidentId', 'location', 'accuracy', 'updatedAt'
        ])
        && data.stationId == currentUserData().stationId
        && data.updatedBy == request.auth.uid
        && data.incidentId is string
        && data.incidentId.matches('^[A-Za-z0-9_-]+$')
        && data.location is latlng
        && data.accuracy is number
        && data.accuracy >= 0
        && data.accuracy <= 50
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && incidentIsActiveAndAssignedNearby(data.incidentId, data.location);
    }

    match /incidents/{incidentId} {
      allow read, write: if false;
    }

    match /incidentUnitLocations/{locationId} {
      // A station may see its own GPS record; administrators may review records.
      // No public or all-stations read access to incident coordinates.
      allow read: if isAdmin()
        || (ownsIncidentLocation(locationId)
          && resource.data.get('updatedBy', null) == request.auth.uid);
      allow create: if validIncidentUnitLocation(locationId);
      allow update: if validIncidentUnitLocation(locationId)
        && resource.data.get('updatedBy', null) == request.auth.uid
        && resource.data.stationId == request.resource.data.stationId;
      // Cleanup must remain possible when an incident ends or access is revoked.
      allow delete: if isAdmin()
        || (ownsIncidentLocation(locationId)
          && resource.data.get('updatedBy', null) == request.auth.uid);
    }

    // Private account presence. Separate sessions preserve multi-tab/device
    // status; presence is a UI signal, never an authorization grant.
    match /accountPresenceSessions/{sessionId} {
      function validPresence() {
        let data = request.resource.data;
        return data.keys().hasAll(['uid', 'stationId', 'lastSeenAt'])
          && data.keys().hasOnly(['uid', 'stationId', 'lastSeenAt'])
          && sessionId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$')
          && data.uid == request.auth.uid
          && isAnyRole()
          && (data.stationId == null || (data.stationId is string && data.stationId.size() <= 128))
          && data.stationId == currentUserData().get('stationId', null)
          && data.lastSeenAt is timestamp && data.lastSeenAt == request.time;
      }
      allow read: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid
        || (resource.data.stationId is string && canManageStation(resource.data.stationId)));
      allow create: if isSignedIn() && validPresence();
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && validPresence();
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Shared map pins are visible only to signed-in accounts. Ownership is
    // separate so map readers never receive creator identities.
    function firePinWriter() { return isSignedIn() && (isAuthorized() || isHead() || isAdmin()); }
    function validFirePin() {
      let data = request.resource.data;
      return data.keys().hasAll(['lat', 'lng', 'stationId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['lat', 'lng', 'stationId', 'status', 'createdAt', 'updatedAt'])
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (data.stationId == null || (data.stationId is string && data.stationId.size() <= 128))
        && data.status in ['active', 'cleared'] && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    match /firePins/{pinId} {
      allow read: if isSignedIn();
      allow create: if firePinWriter() && pinId.matches('^[a-zA-Z0-9]{20}$') && validFirePin() && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.stationId == currentUserData().get('stationId', null)
        && getAfter(/databases/$(database)/documents/firePinOwners/$(pinId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/firePinOwners/$(pinId)).data.stationId == request.resource.data.stationId;
      allow update: if firePinWriter() && validFirePin() && resource.data.status == 'active'
        && request.resource.data.stationId == resource.data.stationId && request.resource.data.createdAt == resource.data.createdAt
        && (get(/databases/$(database)/documents/firePinOwners/$(pinId)).data.uid == request.auth.uid
          || isAdmin() || (resource.data.stationId is string && canManageStation(resource.data.stationId)))
        // Clearing goes through the verified server action so responders end together.
        && request.resource.data.status == 'active';
      allow delete: if false;
    }
    match /firePinOwners/{pinId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin()
        || (resource.data.stationId is string && canManageStation(resource.data.stationId)));
      allow create: if firePinWriter() && pinId.matches('^[a-zA-Z0-9]{20}$')
        && request.resource.data.keys().hasAll(['uid', 'stationId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'stationId', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.stationId == currentUserData().get('stationId', null)
        && getAfter(/databases/$(database)/documents/firePins/$(pinId)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/firePins/$(pinId)).data.stationId == request.resource.data.stationId;
      allow update, delete: if false;
    }

    // ---------- hydrants ----------

    match /hydrants/{hydrantId} {
      // Public landing page: anyone can VIEW hydrants without signing in.
      allow read: if true;

      // Server-only (POST /api/hydrants): the barangay must be derived from the
      // coordinates and checked against the creator's station AOR, which rules
      // cannot do. Clients could otherwise self-declare an in-AOR barangay.
      allow create: if false;

      // Admin may update anything. Heads and station accounts may update the
      // approved field set, and authorized members only operationalStatus,
      // both only inside their station's AOR (hydrantAccess). barangay and
      // location are in neither list, so non-admins never move hydrants.
      allow update: if canUpdateHydrant();

      allow delete: if isAdmin();

      match /reports/{reportId} {
        // Direct-path access (read a hydrant's own reports, file new ones).
        allow read: if true;
        // Filing and managing reports follow the hydrant's AOR, like edits.
        allow create: if hydrantAccess(hydrantBarangay(hydrantId)) in ['admin', 'head', 'authorized']
          && (!('reporterUid' in request.resource.data) || request.resource.data.reporterUid == request.auth.uid);
        allow update: if hydrantAccess(hydrantBarangay(hydrantId)) in ['admin', 'head']
          && request.resource.data.get('reporterUid', null) == resource.data.get('reporterUid', null);
        allow delete: if hydrantAccess(hydrantBarangay(hydrantId)) in ['admin', 'head'];
      }
    }

    // ---------- reports collection group ----------

    // The ReportsPanel uses a collectionGroup('reports') query to gather
    // reports across ALL hydrants. Collection-group queries are NOT covered
    // by the nested rule above - they need this recursive-wildcard match.
    match /{path=**}/reports/{reportId} {
      allow read: if true;
    }

    // ---------- meta / counters ----------

    // The hydrant ID counter (HYD-001, HYD-002, ...) lives here.
    // Authorized, head, and admin may read+write so createHydrant() can
    // atomically increment the counter inside a transaction.
    match /meta/{docId} {
      allow read, write: if isAuthorized() || isHead() || isAdmin();
    }

    // ---------- immutable build version log ----------
    // buildVersions/{buildId}: chapter, version, commit, buildId, builtAt,
    // frozenAt, frozenBy, notes, sourceState. Optional environment, deploymentUrl,
    // releaseSummary support older clients/records. Admin-only; immutable.
    function isValidFrozenBuild(buildId) {
      let data = request.resource.data;
      return data.keys().hasAll(['chapter', 'version', 'commit', 'buildId', 'builtAt', 'frozenAt', 'frozenBy', 'notes', 'sourceState'])
        && data.keys().hasOnly(['chapter', 'version', 'commit', 'buildId', 'builtAt', 'frozenAt', 'frozenBy', 'notes', 'sourceState', 'environment', 'deploymentUrl', 'releaseSummary'])
        && (!('environment' in data) || data.environment in ['production', 'staging', 'testing'])
        && (!('deploymentUrl' in data) || (data.deploymentUrl is string && data.deploymentUrl.size() <= 2048
          && data.deploymentUrl.matches('^https?://[A-Za-z0-9][A-Za-z0-9.:-]*([/?#][^[:space:]]*)?$')))
        && (!('releaseSummary' in data) || (data.releaseSummary is string && data.releaseSummary.size() <= 2000
          && data.releaseSummary.matches('(?s).*[^[:space:]].*')))
        && data.sourceState in ['clean', 'modified', 'unknown']
        && data.chapter is int && data.chapter == 3
        && data.version is string && data.version.size() > 0 && data.version.size() <= 64
        && data.commit is string && data.commit.matches('^[a-f0-9]{40}$')
        && data.buildId is string && data.buildId == buildId
        && data.buildId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$')
        && data.builtAt is timestamp && data.builtAt <= request.time
        && data.frozenAt is timestamp && data.frozenAt == request.time
        && data.frozenBy is string && data.frozenBy.size() <= 128 && data.frozenBy == request.auth.uid
        && data.notes is string && data.notes.size() <= 1000;
    }

    match /buildVersions/{buildId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidFrozenBuild(buildId);
      allow update, delete: if false;
    }

    // ---------- default deny ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
