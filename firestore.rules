rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isGeneral()    { return userRole() == 'general'; }
    function isAuthorized() { return userRole() == 'authorized'; }
    function isHead()       { return userRole() == 'head'; }
    function isAdmin()      { return userRole() == 'admin'; }

    function isAnyRole() {
      return isGeneral() || isAuthorized() || isHead() || isAdmin();
    }

    function onlyChangedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ---------- users ----------

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && onlyChangedFields(['lastLoginAt']));

      allow create, delete: if isAdmin();
    }

    // ---------- hydrants ----------

    match /hydrants/{hydrantId} {
      allow read: if isAnyRole();

      allow create: if isAuthorized() || isAdmin();

      allow update: if isAdmin()
        || (isAuthorized() && onlyChangedFields([
              'status', 'operationalStatus', 'notes', 'photoURL', 'photoUrl',
              'hazardFlags', 'hazards', 'pressureStatus', 'waterCleanliness',
              'updatedBy', 'updatedAt'
            ]))
        || (isHead() && onlyChangedFields([
              'lastMaintenanceDate', 'nextMaintenanceDate',
              'updatedBy', 'updatedAt'
            ]));

      allow delete: if isAdmin();

      match /reports/{reportId} {
        allow read: if isAnyRole();
        allow create, update, delete: if isHead() || isAdmin();
      }
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}