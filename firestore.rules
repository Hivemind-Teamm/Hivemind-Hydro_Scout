rules_version = '2';
// unitLocations/{uid}_{deviceUUID}: stationId, updatedBy, incidentId, location (GeoPoint), accuracy, updatedAt.
// Temporary F1 contract: station accounts have accountType == 'station' and stationId.
//
// F1 Station Accounts + AOR:
// users/{uid}.aorBarangays contains the barangays inside that user's
// Area of Responsibility. A station/authorized user may update only a
// hydrant's operationalStatus when that hydrant belongs to their AOR.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
        : null;
    }

    function isGeneral()    { return userRole() == 'general'; }
    function isAuthorized() { return userRole() == 'authorized'; }
    function isHead()       { return userRole() == 'head'; }
    function isAdmin()      { return userRole() == 'admin'; }

    function isAnyRole() {
      return isGeneral() || isAuthorized() || isHead() || isAdmin();
    }

    function onlyChangedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // F1: true when the existing hydrant belongs to one of the
    // barangays assigned to the signed-in user's Area of Responsibility.
    //
    // We deliberately check resource.data.barangay (the existing document),
    // not request.resource.data.barangay, so a client cannot move a hydrant
    // into its own AOR as part of an update.
    function hydrantIsInUserAor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && resource.data.get('barangay', null) is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('aorBarangays', []) is list
        && resource.data.get('barangay', null)
           in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('aorBarangays', []);
    }

    // ---------- users ----------

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && onlyChangedFields(['lastLoginAt']));

      // New users can create their own document (signup flow).
      // Only admins can create documents for other users or delete any.
      // Self-signup cannot grant a role or station assignment used by location rules.
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.role == 'general');

      allow delete: if isAdmin();
    }

    // ---------- incident-linked substation positions ----------

    function isSubAdmin() {
      return isSignedIn() && userRole() == 'sub_admin';
    }

    function isStationAccount() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', null) == 'station';
    }

    function isLocationOwner(locationId) {
      return isSignedIn()
        && locationId.matches('^' + request.auth.uid + '_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function incidentIdIsValid(incidentId) {
      return incidentId is string
        && incidentId.matches('^[A-Za-z0-9_-]+$');
    }

    function validIncidentLocation() {
      let data = request.resource.data;
      return incidentIdIsValid(data.incidentId)
        && incidentIsActiveAndNearby(data.incidentId, data.location);
    }

    function incidentIsActiveAndNearby(incidentId, location) {
      let incidentPath = /databases/$(database)/documents/incidents/$(incidentId);
      let stationId = get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('stationId', null);

      return exists(incidentPath)
        && get(incidentPath).data.get('status', null) == 'active'
        && get(incidentPath).data.get('location', null) is latlng
        && location.distance(get(incidentPath).data.location) <= 500
        // Proximity alone cannot authorize station tracking.
        // Only trusted server processes may manage incident assignments.
        && get(incidentPath).data.get('assignedStationIds', null) is list
        && stationId is string
        && stationId in get(incidentPath).data.assignedStationIds;
    }

    function validUnitLocation(locationId) {
      let data = request.resource.data;
      return isSubAdmin()
        && isStationAccount()
        && isLocationOwner(locationId)
        && data.keys().hasAll([
          'stationId', 'updatedBy', 'incidentId',
          'location', 'accuracy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'stationId', 'updatedBy', 'incidentId',
          'location', 'accuracy', 'updatedAt'
        ])
        && data.stationId is string
        && data.stationId.size() > 0
        && data.stationId.size() <= 128
        && data.stationId.matches('^[A-Za-z0-9_-]+$')
        && data.stationId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('stationId', null)
        && data.updatedBy == request.auth.uid
        && data.incidentId is string

        && data.location is latlng
        && data.accuracy is number
        && data.accuracy >= 0
        && data.accuracy <= 50
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && validIncidentLocation();
    }

    match /incidents/{incidentId} {
      // Incident provisioning remains restricted to trusted server processes.
      allow read, write: if false;
    }

    match /unitLocations/{locationId} {
      allow read: if isAdmin() || (isSubAdmin() && isStationAccount());

      allow create: if validUnitLocation(locationId);

      allow update: if validUnitLocation(locationId)
        && resource.data.updatedBy == request.auth.uid
        && resource.data.stationId == request.resource.data.stationId;

      allow delete: if isAdmin()
        || (isLocationOwner(locationId)
            && resource.data.updatedBy == request.auth.uid);
    }
    // ---------- hydrants ----------

    match /hydrants/{hydrantId} {
      // Public landing page: anyone can VIEW hydrants without signing in.
      allow read: if true;

      allow create: if isAuthorized() || isHead() || isAdmin();

      // Existing permissions:
      //   - Admin may update the hydrant.
      //   - Head may update the existing approved field set.
      //
      // F1 AOR permission:
      //   - Authorized/station users may update ONLY operationalStatus.
      //   - The existing hydrant's barangay must belong to their AOR.
      //   - They cannot change barangay or combine the status update with
      //     another field.
      allow update: if isAdmin()
        || (isHead() && onlyChangedFields([
              'operationalStatus',
              'pressureStatus',
              'waterCleanliness',
              'hazards',
              'photos',
              'notes',
              'fieldNotes',
              'register',
              'lastMaintenanceDate',
              'nextMaintenanceDate',
              'updatedBy',
              'updatedAt'
            ]))
        || (isSubAdmin()
            && hydrantIsInUserAor()
            && onlyChangedFields([
              'operationalStatus',
              'pressureStatus',
              'waterCleanliness',
              'hazards',
              'photos',
              'notes',
              'fieldNotes',
              'register',
              'lastMaintenanceDate',
              'nextMaintenanceDate',
              'updatedBy',
              'updatedAt'
            ]))
        || (isAuthorized()
            && hydrantIsInUserAor()
            && onlyChangedFields(['operationalStatus']));

      allow delete: if isAdmin();

      match /reports/{reportId} {
        // Direct-path access (read a hydrant's own reports, file new ones).
        allow read: if true;
        allow create: if isAuthorized() || isHead() || isAdmin()
          || (isSubAdmin()
              && exists(/databases/$(database)/documents/hydrants/$(hydrantId))
              && get(/databases/$(database)/documents/hydrants/$(hydrantId)).data.barangay is string
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aorBarangays is list
              && get(/databases/$(database)/documents/hydrants/$(hydrantId)).data.barangay
                 in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aorBarangays);
        allow update, delete: if isHead() || isAdmin()
          || (isSubAdmin()
              && exists(/databases/$(database)/documents/hydrants/$(hydrantId))
              && get(/databases/$(database)/documents/hydrants/$(hydrantId)).data.barangay is string
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aorBarangays is list
              && get(/databases/$(database)/documents/hydrants/$(hydrantId)).data.barangay
                 in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aorBarangays);
      }
    }

    // ---------- reports collection group ----------

    // The ReportsPanel uses a collectionGroup('reports') query to gather
    // reports across ALL hydrants. Collection-group queries are NOT covered
    // by the nested rule above - they need this recursive-wildcard match.
    match /{path=**}/reports/{reportId} {
      allow read: if true;
    }

    // ---------- meta / counters ----------

    // The hydrant ID counter (HYD-001, HYD-002, ...) lives here.
    // Authorized, head, and admin may read+write so createHydrant() can
    // atomically increment the counter inside a transaction.
    match /meta/{docId} {
      allow read, write: if isAuthorized() || isHead() || isAdmin();
    }

    // ---------- default deny ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}