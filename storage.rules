rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — owner can read/write their own
    match /profile-photos/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Hydrant photos — any signed-in user can read; authorized/head/admin can write
    match /hydrants/{hydrantId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
